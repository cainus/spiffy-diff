{
  "name": "spiffy",
  "version": "0.1.0",
  "private": true,
  "description": "Top-down explanations of pull requests and branches.",
  "author": "Gregg Caines",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac --dir",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run knip",
    "prepare": "husky"
  },
  "dependencies": {
    "ai": "^7.0.142",
    "ai-sdk-provider-claude-code": "^4.3.3",
    "ai-sdk-provider-codex-cli": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.146",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@pierre/diffs": "^1.5.2",
    "@streamdown/code": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "shadcn": "^4.21.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron": true,
    "fsevents": false,
    "electron-winstaller": false
  }
}
